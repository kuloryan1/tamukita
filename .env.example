# Local development only. Change these values before exposing any service.
POSTGRES_USER="tamukita"
POSTGRES_PASSWORD="local-only-change-before-deploy"
POSTGRES_DB="tamukita"
POSTGRES_PORT="5432"
REDIS_PORT="6379"
# Keep this local-development URL in sync with the database credentials above.
DATABASE_URL="postgresql://tamukita:local-only-change-before-deploy@localhost:5432/tamukita?schema=public"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Add production secrets through the deployment platform's secret store.
AUTH_SECRET="replace-with-a-long-random-secret"
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
XENDIT_REFUND_WEBHOOK_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="TamuKita <noreply@tamukita.io>"
RESELLER_BASIC_ACTIVATION_PRICE_IDR=""
RESELLER_PREMIUM_ACTIVATION_PRICE_IDR=""
CUSTOMER_ACTIVATION_PRICE_IDR="0"
INVITATION_HOSTING_TERM_DAYS="365"
# Leave unset to disable paid hosting renewal until the admin sets a price.
# INVITATION_HOSTING_RENEWAL_PRICE_IDR="49000"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PRIVATE_BUCKET_NAME=""
R2_PUBLIC_BUCKET_NAME=""
R2_PUBLIC_BASE_URL=""
R2_BACKUP_ACCESS_KEY_ID=""
R2_BACKUP_SECRET_ACCESS_KEY=""
BACKUP_BUCKET=""
BACKUP_COMPOSE_PROJECT_NAME=""
BACKUP_POSTGRES_SERVICE="postgres"
BACKUP_PREFIX="tamukita/postgres"
BACKUP_AGE_RECIPIENT=""
# Keep the matching private age identity outside this repository and deployment image.
BACKUP_AGE_IDENTITY_FILE=""
