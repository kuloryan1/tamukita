BACKUP_COMPOSE_PROJECT_NAME=replace-with-dokploy-compose-project-name
BACKUP_POSTGRES_SERVICE=postgres
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BACKUP_ACCESS_KEY_ID=replace-with-backup-only-access-key-id
R2_BACKUP_SECRET_ACCESS_KEY=replace-with-backup-only-secret
BACKUP_BUCKET=replace-with-private-backup-bucket
BACKUP_AGE_RECIPIENT=age1replace-with-public-recipient
BACKUP_PREFIX=tamukita/postgres
# Optional S3-compatible endpoint override. Leave empty to use Cloudflare R2.
BACKUP_S3_ENDPOINT=
# Set true only for local MinIO tests; remote HTTP endpoints are rejected.
BACKUP_S3_ALLOW_HTTP=false
# Optional; leave empty to rely on the systemd journal.
BACKUP_ALERT_WEBHOOK_URL=
