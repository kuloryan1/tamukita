{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": false
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{ts,tsx}",
      "tests/**/*.{ts,tsx}",
      "!src/generated",
      "e2e/**/*.{ts,tsx}",
      "scripts/**/*.ts",
      "next.config.ts",
      "playwright.config.ts",
      "prisma.config.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "enabled": false
  }
}
