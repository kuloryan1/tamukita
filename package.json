{
  "name": "tamukita-io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "worker": "tsx src/worker.ts",
    "start": "next start",
    "lint": "biome lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:templates": "vitest run src/templates/registry.test.tsx",
    "test:e2e": "playwright test",
    "test:load:public": "k6 run tests/load/public-invitation.js",
    "test:load:api": "k6 run tests/load/api-health.js",
    "test:performance:lcp": "playwright test --config=playwright.performance.config.ts",
    "db:seed:e2e": "tsx scripts/seed-e2e-admin.ts",
    "r2:lifecycle": "tsx scripts/r2-pending-lifecycle.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "^6.3.12",
    "dotenv": "18.0.7",
    "ioredis": "^6.0.0",
    "lucide-react": "1.54.0",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-easy-crop": "^6.2.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  }
}
